{
  "name": "@ai-radio/web",
  "version": "0.0.0",
  "private": true,
  "description": "AI Radio PWA frontend — React + Vite + Tailwind + Zustand",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
