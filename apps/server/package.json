{
  "name": "@ai-radio/server",
  "version": "0.0.0",
  "private": true,
  "description": "AI Radio Express server — WebSocket, REST API, and module orchestration",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@ai-radio/brain": "workspace:*",
    "@ai-radio/memory": "workspace:*",
    "@ai-radio/music": "workspace:*",
    "@ai-radio/prompts": "workspace:*",
    "@ai-radio/scheduler": "workspace:*",
    "@ai-radio/shared": "workspace:*",
    "@ai-radio/tts": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
